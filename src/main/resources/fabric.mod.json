{
  "schemaVersion": 1,
  "id": "create_central_kitchen",
  "version": "${version}",
  "name": "Create: Central Kitchen (Fly Port)",
  "description": "Integrated cooking automation for Create. Unofficial Fabric 26.2 port of Create: Central Kitchen by DragonsPlus, for Create Fly.",
  "authors": [
    "DragonsPlus"
  ],
  "contributors": [
    "GravisLudio (Fabric 26.2 port)"
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/create-central-kitchen-fly-port",
    "sources": "https://github.com/GravisLudio/create-central-kitchen-fly-26.2",
    "issues": "https://github.com/GravisLudio/create-central-kitchen-fly-26.2/issues"
  },
  "license": "LGPL-3.0-or-later",
  "icon": "icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "plus.dragons.createcentralkitchen.common.CCKCommon"
    ],
    "client": [
      "plus.dragons.createcentralkitchen.client.CCKClient"
    ],
    "jei_mod_plugin": [
      "plus.dragons.createcentralkitchen.integration.jei.CCKJeiPlugin"
    ]
  },
  "mixins": [
    "create_central_kitchen.mixins.json"${integration_mixin_entries},
    {
      "config": "create_central_kitchen.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_api_version}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=25",
    "create": "${create_version_range}"
  },
  "suggests": {
    "jei": "${jei_version}",
    "farmersdelight": "*"
  }
}
